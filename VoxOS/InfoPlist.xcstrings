    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS muss mit Ihrem Browser interagieren, um die aktuelle Website zu erkennen und website-spezifische Konfigurationen anzuwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "VoxOS needs to interact with your browser to detect the current website for applying website-specific configurations."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 需要与浏览器交互以检测当前网站，从而应用针对特定网站的配置。"
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription" : {
      "comment" : "Privacy - Audio Capture Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS hört, was Ihr Mac abspielt, um die Musikbalken in der Notch zu bewegen und es zu transkribieren, wenn Sie Systemaudio aufnehmen oder Besprechungsnotizen erstellen. Gespeichert wird nur, was Sie aufnehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "VoxOS listens to what your Mac plays to move the notch's music bars, and to transcribe it when you capture system audio or take meeting notes. Only what you capture or record is kept."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 会监听 Mac 播放的声音，用于让刘海中的音乐条跳动，并在你捕获系统音频或记录会议纪要时进行转写。只会保留你捕获或录制的内容。"
          }
        }
      }
    },
    "NSHumanReadableCopyright" : {
      "comment" : "Copyright (human-readable)",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ""
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : ""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ""
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS benötigt Zugriff auf Ihr Mikrofon, um Audio für die Transkription aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "VoxOS needs access to your microphone to record audio for transcription."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 需要访问麦克风以录制音频用于转录。"
          }
        }
      }
    },
    "NSScreenCaptureUsageDescription" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS benötigt Zugriff auf die Bildschirmaufnahme, um Kontext von Ihrem Bildschirm für eine höhere Transkriptionsgenauigkeit zu erfassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "VoxOS needs screen recording access to understand context from your screen for improved transcription accuracy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 需要屏幕录制权限以理解屏幕上的上下文，提高转录准确性。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
