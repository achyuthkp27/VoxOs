          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 还是开源软件，你可以查看每一行代码。"
          }
        }
      }
    },
    "VoxOS is context-aware." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS erkennt den Kontext."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 支持上下文感知。"
          }
        }
      }
    },
    "VoxOS is private by default" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS ist standardmäßig privat"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 默认保护隐私"
          }
        }
      }
    },
    "VoxOS is private by default. No data leaves your device unless you opt in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS ist standardmäßig privat. Keine Daten verlassen dein Gerät, sofern du dem nicht zustimmst."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 默认保护隐私。除非你主动选择，否则任何数据都不会离开你的设备。"
          }
        }
      }
    },
    "VoxOS listens for “%@” from now on, however it is heard" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS achtet ab jetzt auf „%@“, wie auch immer es gehört wird"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从现在起，无论听成什么，VoxOS 都会识别“%@”"
          }
        }
      }
    },
    "VoxOS modes include Dictation, Enhance, Email, Assistant, Rewrite, Ask, Summarize, and Translate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS-Modi umfassen Diktat, Verbesserung, E-Mail, Assistent, Umschreiben, Fragen, Zusammenfassen und Übersetzen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 的模式包括听写、润色、邮件、助手、改写、提问、总结和翻译。"
          }
        }
      }
    },
    "VoxOS needs Screen Recording permission to capture system audio." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS benötigt die Berechtigung Bildschirmaufnahme, um Systemaudio aufzunehmen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 需要屏幕录制权限才能捕获系统音频。"
          }
        }
      }
    },
    "VoxOS needs at least one mode to record. Create one to start dictating." : {
      "comment" : "A description of the benefits of creating a mode.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS benötigt mindestens einen Modus zum Aufnehmen. Erstelle einen, um mit dem Diktieren zu beginnen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 至少需要一个模式才能录音。创建一个模式即可开始听写。"
          }
        }
      }
    },
    "VoxOS needs it to hear your shortcut and paste into other apps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS braucht sie, um dein Kürzel zu erkennen und in andere Apps einzufügen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 需要它来检测你的快捷键并粘贴到其他应用。"
          }
        }
      }
    },
    "VoxOS progress" : {
      "comment" : "A placeholder text that is displayed when the user has not recorded any VoxOS sessions.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
