      }
    },
    "VoxOS app is not available" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS-App ist nicht verfügbar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS App 不可用"
          }
        }
      }
    },
    "VoxOS automatically understands what you are working with and selects your preferred setup. You can always configure this by editing or creating new modes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS erkennt automatisch, woran du arbeitest, und wählt deine bevorzugte Konfiguration aus. Du kannst dies jederzeit anpassen, indem du Modi bearbeitest oder neue erstellst."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 会自动识别你正在处理的内容，并选用你偏好的设置。你随时可以通过编辑或创建新模式来进行配置。"
          }
        }
      }
    },
    "VoxOS can select the right mode from the app you are using and the rules you configure." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS kann anhand der verwendeten App und der konfigurierten Regeln den passenden Modus auswählen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 可以根据你正在使用的 App 和你配置的规则选择合适的模式。"
          }
        }
      }
    },
    "VoxOS could not add itself to your login items" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS konnte sich nicht zu deinen Anmeldeobjekten hinzufügen"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 无法将自己添加到登录项"
          }
        }
      }
    },
    "VoxOS could not remove itself from your login items" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS konnte sich nicht aus deinen Anmeldeobjekten entfernen"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 无法将自己从登录项中移除"
          }
        }
      }
    },
    "VoxOS could not switch to another microphone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS konnte nicht zu einem anderen Mikrofon wechseln."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 无法切换到其他麦克风。"
          }
        }
      }
    },
    "VoxOS couldn't access its storage location. Your transcriptions will not be saved between sessions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS konnte nicht auf den Speicherort zugreifen. Deine Transkriptionen werden nicht zwischen Sitzungen gespeichert."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 无法访问其存储位置。你的转写记录将无法跨会话存储。"
          }
        }
      }
    },
    "VoxOS couldn't access the macOS Keychain. Quit and reopen VoxOS. If the problem continues, restart your Mac." : {
      "comment" : "Error message displayed when the macOS Keychain is unavailable.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS konnte nicht auf den macOS-Schlüsselbund zugreifen. Beende VoxOS und öffne die App erneut. Falls das Problem weiterhin besteht, starte deinen Mac neu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 无法访问 macOS 钥匙串。请退出并重新打开 VoxOS。如果问题仍然存在，请重新启动 Mac。"
          }
        }
      }
    },
    "VoxOS couldn't remove the saved license. Please try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS konnte die gespeicherte Lizenz nicht entfernen. Bitte versuche es erneut."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 无法移除已保存的许可证。请重试。"
          }
        }
      }
    },
    "VoxOS couldn't save the license. Please try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS konnte die Lizenz nicht speichern. Bitte versuche es erneut."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 无法保存许可证。请重试。"
          }
        }
      }
    },
    "VoxOS couldn't start the trial because the macOS Keychain is unavailable. Quit and reopen VoxOS. If the problem continues, restart your Mac." : {
      "comment" : "Error message displayed when the macOS Keychain is unavailable while starting a trial.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS konnte den Testzeitraum nicht starten, da der macOS-Schlüsselbund nicht verfügbar ist. Beende VoxOS und öffne die App erneut. Falls das Problem weiterhin besteht, starte deinen Mac neu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 无法开始试用，因为 macOS 钥匙串不可用。请退出并重新打开 VoxOS。如果问题仍然存在，请重新启动 Mac。"
          }
        }
      }
    },
    "VoxOS is Context-Aware" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS erkennt den Kontext"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 支持上下文感知"
