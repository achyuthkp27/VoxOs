      }
    },
    "VoxOS is Open Source" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS ist Open Source"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS 是开源软件"
          }
        }
      }
    },
    "VoxOS is also open source, so you can inspect every single line of code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoxOS ist auch Open Source, sodass du jede Codezeile einsehen kannst."
          }
        },
