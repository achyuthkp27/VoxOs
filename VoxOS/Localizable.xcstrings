    "Use the fn key (hold to talk, double-tap for Agent)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "fn-Taste verwenden (halten zum Sprechen, zweimal tippen für Agent)"
