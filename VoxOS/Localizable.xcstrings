    "Hold %@ and press the first letter of an app's name to bring it forward. An app that isn't running is opened." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte %@ gedrückt und drücke den Anfangsbuchstaben einer App, um sie nach vorne zu holen. Eine App, die nicht läuft, wird geöffnet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 %@ 并按下应用名称的首字母，即可将其调到最前。未运行的应用会被打开。"
          }
        }
      }
    },
    "Hold %@ to dictate" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gedrückt halten zum Diktieren"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 %@ 进行听写"
          }
        }
      }
    },
    "Hold fn to talk, tap fn to record hands-free, hold fn+⌃ to dictate and press Return. Double-tap ⌃ for the Agent — it sends when you stop talking." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte fn zum Sprechen, tippe fn für freihändiges Aufnehmen, halte fn+⌃, um zu diktieren und Return zu drücken. Tippe zweimal auf ⌃ für den Agent – er sendet, sobald du aufhörst zu sprechen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 fn 说话，轻点 fn 免手持录音，按住 fn+⌃ 听写并按回车键。连按两次 ⌃ 使用智能体——你停止说话时它会自动发送。"
          }
        }
      }
    },
